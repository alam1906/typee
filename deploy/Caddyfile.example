typee.example.com {
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	handle /_app/immutable/* {
		root * /var/www/typee
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	handle /_app/* {
		root * /var/www/typee
		file_server {
			precompressed br gzip
		}
	}

	handle {
		root * /var/www/typee
		try_files {path} /200.html
		file_server {
			precompressed br gzip
		}
	}
}
